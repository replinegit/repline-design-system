{
  "meta": {
    "name": "Repline Design System",
    "version": "1.0",
    "status": "final",
    "sourceOfTruth": "01_Repline_Design_System_v1.0.md",
    "themes": [
      "light",
      "dark"
    ],
    "platforms": [
      "web",
      "pwa"
    ],
    "baseGrid": 4,
    "referenceViewport": 360,
    "language": "ru-RU"
  },
  "themes": {
    "light": {
      "bg": "#F3F2EE",
      "surface": "#FAF9F5",
      "surface2": "#F0EEE8",
      "line": "#E3E0D8",
      "hairline": "#EBE8E1",
      "text": "#191A1A",
      "textSecondary": "#5E6058",
      "textTertiary": "#8A8B82"
    },
    "dark": {
      "bg": "#131211",
      "surface": "#1C1B19",
      "surface2": "#242220",
      "line": "#302E2B",
      "hairline": "#282624",
      "text": "#F2F0ED",
      "textSecondary": "#A0A099",
      "textTertiary": "#7C7C75"
    }
  },
  "color": {
    "action": {
      "base": "#F98200",
      "bright": "#FF9C10",
      "ink": "#2B1B06",
      "textLight": "#B4520A",
      "textDark": "#FFA93A",
      "softLight": "#FBEEDB",
      "softDark": "#2E2415",
      "brightDark": "#FFA51F"
    },
    "result": {
      "base": "#2F6BFF",
      "ink": "#0B1730",
      "textLight": "#1E4FD0",
      "textDark": "#8FB0FF",
      "softLight": "#E9EEFC",
      "softDark": "#182036"
    },
    "danger": {
      "base": "#B3261E",
      "textLight": "#A8241C",
      "textDark": "#F5836E",
      "softLight": "#FAEBE8",
      "softDark": "#2E1A17"
    },
    "notes": {
      "success": "role carried by color.result, no separate success color",
      "warning": "role carried by color.action, no separate warning color"
    }
  },
  "gradient": {
    "streak": {
      "role": "Streak card only",
      "light": "linear-gradient(140deg,#FF9410 0%,#FFB554 46%,#FBE6C8 100%)",
      "dark": "radial-gradient(125% 115% at 88% 6%,rgba(255,148,16,.44) 0%,rgba(255,148,16,0) 62%),linear-gradient(150deg,#2C2318 0%,#1D1A16 100%)",
      "textLight": "#2B1B06",
      "textDark": "#F2F0ED"
    },
    "personalRecord": {
      "role": "Personal Record card only",
      "light": "linear-gradient(140deg,#4A82FF 0%,#9BBAFF 46%,#E4EBFA 100%)",
      "dark": "radial-gradient(125% 115% at 88% 6%,rgba(74,130,255,.44) 0%,rgba(74,130,255,0) 62%),linear-gradient(150deg,#1A2033 0%,#16181F 100%)",
      "textLight": "#0B1730",
      "textDark": "#F2F0ED"
    },
    "primaryCta": {
      "role": "Primary actions only",
      "light": "linear-gradient(96deg,#FFA61A 0%,#F98200 100%)",
      "dark": "linear-gradient(96deg,#FFA61A 0%,#F98200 100%)",
      "textLight": "#2B1B06",
      "textDark": "#2B1B06"
    },
    "rules": {
      "light": "colour to light: second stop is always a light neutral or a very light derivative",
      "dark": "colour to depth: glow in the corner plus a deep derivative of the same hue",
      "forbiddenLight": [
        "to black",
        "to graphite",
        "to near-black"
      ],
      "maxGradientSurfacesPerScreen": 4
    }
  },
  "typography": {
    "families": {
      "display": {
        "family": "Tektur",
        "weights": [
          700
        ],
        "usage": "metrics, league name, XP, logotype, avatar initials"
      },
      "text": {
        "family": "Golos Text",
        "weights": [
          400,
          600,
          700
        ],
        "usage": "all interface text"
      },
      "mono": {
        "family": "JetBrains Mono",
        "weights": [
          600,
          700
        ],
        "usage": "numeric data"
      }
    },
    "forbiddenFamilies": [
      "Unbounded"
    ],
    "styles": {
      "metric": {
        "family": "Tektur",
        "size": 46,
        "weight": 700,
        "lineHeight": 0.9
      },
      "leagueName": {
        "family": "Tektur",
        "size": 19,
        "weight": 700,
        "lineHeight": 1.05
      },
      "leagueXp": {
        "family": "Tektur",
        "size": 17,
        "weight": 700,
        "lineHeight": 1.0
      },
      "screenTitle": {
        "family": "Golos Text",
        "size": 19,
        "weight": 700,
        "lineHeight": 1.1
      },
      "rowTitle": {
        "family": "Golos Text",
        "size": 17,
        "weight": 700,
        "lineHeight": 1.15
      },
      "body": {
        "family": "Golos Text",
        "size": 15,
        "weight": 600,
        "lineHeight": 1.35
      },
      "bodySecondary": {
        "family": "Golos Text",
        "size": 13.5,
        "weight": 400,
        "lineHeight": 1.42
      },
      "blockLabel": {
        "family": "Golos Text",
        "size": 11.5,
        "weight": 700,
        "lineHeight": 1.2,
        "letterSpacing": "0.055em",
        "textTransform": "uppercase"
      },
      "tag": {
        "family": "Golos Text",
        "size": 12,
        "weight": 600,
        "lineHeight": 1.2
      },
      "caption": {
        "family": "Golos Text",
        "size": 11.5,
        "weight": 600,
        "lineHeight": 1.35
      },
      "numeric": {
        "family": "JetBrains Mono",
        "size": 13,
        "weight": 700,
        "lineHeight": 1.0
      }
    },
    "minimumCriticalDataSize": 12
  },
  "spacing": {
    "1": 4,
    "2": 6,
    "3": 8,
    "4": 10,
    "5": 12,
    "6": 14,
    "7": 16,
    "8": 20,
    "blockGap": 12,
    "cardPadding": 16,
    "screenPadding": 14
  },
  "radius": {
    "card": 20,
    "block": 14,
    "button": 14,
    "input": 12,
    "chip": 10,
    "tag": 8,
    "progressBar": 5,
    "circle": "50%"
  },
  "border": {
    "cardLight": "1px solid #EBE8E1",
    "cardDark": "1px solid #302E2B",
    "input": "1.5px",
    "setWaitingRing": "1.5px",
    "setNextRing": "2.5px",
    "streakDefaultRing": "1.4px",
    "streakFreeRing": "1.8px",
    "streakTodayRing": "2.6px",
    "streakFutureRing": "1.2px",
    "focusRing": "2px solid #2F6BFF, offset 2px"
  },
  "shadow": {
    "1": {
      "light": "0 3px 12px rgba(38,32,22,.05)",
      "dark": "0 3px 12px rgba(0,0,0,.40)",
      "usage": "working surfaces, secondary buttons"
    },
    "2": {
      "light": "0 10px 26px rgba(38,32,22,.075)",
      "dark": "0 10px 26px rgba(0,0,0,.50)",
      "usage": "accent cards, primary CTA"
    },
    "3": {
      "light": "0 16px 40px rgba(38,32,22,.11)",
      "dark": "0 16px 40px rgba(0,0,0,.58)",
      "usage": "whole screen"
    },
    "noShadow": [
      "inputs",
      "statuses",
      "tags"
    ]
  },
  "icon": {
    "grid": 24,
    "stroke": 1.9,
    "strokeInsideCircles": [
      2.0,
      2.8
    ],
    "lineCap": "round",
    "lineJoin": "round",
    "fill": "none",
    "fillException": "warning dot only",
    "opticalSizes": {
      "bottomNav": 22,
      "topBar": 21,
      "secondaryButton": 20,
      "insideStateCircle": [
        11,
        18
      ]
    },
    "touchTarget": 44,
    "activeState": "colour and background change only, glyph never changes",
    "set": [
      "home",
      "workouts",
      "nutrition",
      "chronicle",
      "discovery",
      "profile",
      "settings",
      "notifications",
      "done",
      "add",
      "skip",
      "missed-day",
      "in-progress",
      "trend",
      "warning",
      "chevron"
    ],
    "forbiddenMetaphors": [
      "refresh or cycle for workouts",
      "bowl, basket, bag, chopsticks or plate-only for nutrition",
      "sliders for settings",
      "dumbbell or barbell as a section metaphor",
      "play glyph inside an exercise",
      "direct Material or Bootstrap copies"
    ]
  },
  "component": {
    "topNavigation": {
      "height": 58,
      "buttonSize": 44,
      "iconSize": 21,
      "badgeHeight": 16,
      "systemButtons": 2
    },
    "bottomNavigation": {
      "barHeight": 66,
      "itemHeight": 44,
      "iconSize": 22,
      "activeChipRadius": 10,
      "activeItemsWithLabel": 1,
      "items": 6
    },
    "streakCard": {
      "metricSize": 46,
      "dayCircle": 36,
      "dayCircleNarrow": 34,
      "days": 7,
      "gradient": "gradient.streak"
    },
    "personalRecord": {
      "width": "full",
      "metricSize": 46,
      "divider": 1,
      "gradient": "gradient.personalRecord"
    },
    "leagueCard": {
      "emblemContainer": 74,
      "emblemContainerNarrow": 66,
      "emblemFit": "contain",
      "emblemPosition": "center",
      "emblemSafeAreaPercent": 6,
      "overflow": "visible",
      "progressHeight": 8,
      "progressRadius": 5,
      "textPriority": [
        "leagueName",
        "xp",
        "progressBarWithPercent",
        "remainder"
      ]
    },
    "primaryCta": {
      "widthRatio": 1.42,
      "minHeight": 132,
      "iconTile": 42,
      "titleSize": 16,
      "subtitleSize": 11.5,
      "gradient": "gradient.primaryCta"
    },
    "secondaryAction": {
      "widthRatio": 1,
      "minHeight": 61,
      "iconTile": 34,
      "count": 2
    },
    "workoutToday": {
      "headerHeight": 45,
      "rowMinHeight": 132,
      "divider": 1
    },
    "exerciseRow": {
      "titleSize": 17,
      "tagHeight": 26,
      "valuesAlign": "right",
      "order": [
        "title",
        "tags",
        "values",
        "sets"
      ],
      "lastTimeRow": false
    },
    "setControl": {
      "touchTarget": 44,
      "visibleCircle": 34,
      "gap": 4,
      "gapNarrow": 3
    },
    "tag": {
      "height": 26,
      "radius": 8,
      "paddingX": 9,
      "maxPerRow": 3
    },
    "clientCard": {
      "avatar": 72,
      "avatarRadius": 20,
      "nameSize": 19,
      "counterHeight": 34,
      "rule": "avatar height matches the text group height"
    },
    "input": {
      "height": 50,
      "radius": 12,
      "borderWidth": 1.5,
      "states": [
        "default",
        "focus",
        "error",
        "disabled"
      ]
    },
    "status": {
      "height": 34,
      "radius": 10,
      "iconCircle": 22,
      "iconRequired": true
    },
    "sensitiveBlock": {
      "paddingY": 14,
      "paddingX": 16,
      "titleSize": 17,
      "actionsAlign": "right",
      "leftColorBar": false
    },
    "progressBar": {
      "height": 8,
      "radius": 5,
      "numericPercentRequired": true
    },
    "notificationBadge": {
      "height": 16,
      "radius": 8,
      "hiddenAtZero": true,
      "overflowLabel": "99+"
    }
  },
  "state": {
    "streakDay": {
      "done": {
        "fill": "ink",
        "ring": null,
        "symbol": "check"
      },
      "partial": {
        "fill": null,
        "ring": 1.6,
        "innerDisc": 19,
        "symbol": "check inside disc"
      },
      "free": {
        "fill": null,
        "ring": 1.8,
        "symbol": "check"
      },
      "missed": {
        "fill": null,
        "ring": 1.6,
        "symbol": "cross"
      },
      "today": {
        "fill": null,
        "ring": 2.6,
        "symbol": "plus"
      },
      "future": {
        "fill": null,
        "ring": 1.2,
        "symbol": null
      }
    },
    "set": {
      "completed": {
        "fill": "action.bright",
        "symbol": "check"
      },
      "next": {
        "fill": "action.softLight",
        "ring": 2.5,
        "symbol": "number"
      },
      "waiting": {
        "fill": "surface2",
        "ring": 1.5,
        "symbol": "number"
      }
    },
    "input": {
      "default": {
        "fill": "surface2",
        "border": "transparent"
      },
      "focus": {
        "fill": "surface",
        "border": "action.bright",
        "label": "action.textLight"
      },
      "error": {
        "fill": "danger.softLight",
        "border": "danger.textLight"
      },
      "disabled": {
        "fill": "surface2",
        "opacity": 0.55
      }
    },
    "status": {
      "done": {
        "fill": "result.softLight",
        "text": "result.textLight",
        "icon": "done"
      },
      "inProgress": {
        "fill": "action.bright",
        "text": "action.ink",
        "icon": "in-progress"
      },
      "planned": {
        "fill": "surface2",
        "text": "textSecondary",
        "icon": "chevron"
      },
      "missed": {
        "fill": "surface2",
        "text": "textSecondary",
        "icon": "skip",
        "opacity": 0.72
      },
      "error": {
        "fill": "danger.softLight",
        "text": "danger.textLight",
        "icon": "warning"
      }
    }
  },
  "accessibility": {
    "textContrastMin": 4.5,
    "uiContrastMin": 3.0,
    "focusRing": "2px #2F6BFF, offset 2px",
    "minTouchTarget": 44,
    "stateMustNotRelyOnColourAlone": true,
    "reducedMotion": "transitions disabled under prefers-reduced-motion"
  },
